# Exemplo local para operador da Demo Municipal.
# Nao contem credenciais reais ou valores sensiveis.
# Nao copie este arquivo para .env real; preencha credenciais somente fora do Git.

APP_ENV=demo
MUNICIPAL_DEMO_MODE=true
RUN_DEMO_LIVE_TESTS=false

DEMO_ENVIRONMENT_NAME=DEMO_MUNICIPAL_EXEMPLO_LOCAL
DEMO_PROJECT_REF=demoexemploseguro123
DEMO_SUPABASE_URL=https://demoexemploseguro123.supabase.co
DEMO_PANEL_URL=[REDACTED_URL]
AI_ALLOWED_ORIGINS=[REDACTED_URL]

MUNICIPAL_WHATSAPP_ENABLED=false
MUNICIPAL_EMAIL_ENABLED=false

# UUIDs ficticios mascarados para conferencia visual; use os valores completos apenas no arquivo local seguro fora do Git.
DEMO_PLATFORM_ADMIN_USER_ID=11111111...1111
DEMO_MUNICIPAL_ADMIN_USER_ID=22222222...2222
DEMO_GESTOR_USER_ID=33333333...3333
DEMO_LEITURA_USER_ID=44444444...4444
